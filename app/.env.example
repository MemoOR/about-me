# Public, build-time values (safe to expose in the client bundle).
# The reCAPTCHA SITE key (public). The SECRET key lives only in the Lambda.
VITE_RECAPTCHA_SITE_KEY=

# Optional: override the contact API origin during local dev (e.g. a deployed
# CloudFront URL). Leave empty in production — the API is same-origin (/api/*).
VITE_API_BASE=

# PDF / certificate links (were IELTS_CERTIFICATE_URL, *_CV_URL_*, UDEMY_* in app.env)
VITE_IELTS_CERTIFICATE_URL=
VITE_SPANISH_CV_URL_PREVIEW=
VITE_SPANISH_CV_URL_DOWNLOAD=
VITE_ENGLISH_CV_URL_PREVIEW=
VITE_ENGLISH_CV_URL_DOWNLOAD=
VITE_UDEMY_DEVOPS=
VITE_UDEMY_THREEJS=
